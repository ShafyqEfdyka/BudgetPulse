<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Monethra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.BudgetPulse" parent="Theme.Monethra" />

    <!-- Android 12+ (API 31+) Core SplashScreen Theme -->
    <style name="Theme.Monethra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F4F0E0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_bp_padded</item>
        <item name="android:windowSplashScreenBackground">#F4F0E0</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_bp_padded</item>
        <item name="postSplashScreenTheme">@style/Theme.Monethra</item>
    </style>

    <style name="Theme.BudgetPulse.Splash" parent="Theme.Monethra.Splash" />
</resources>
